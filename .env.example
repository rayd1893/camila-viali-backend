# Copiar a .env y completar con los valores reales. Nunca commitear .env.

# --- Seguridad de la API ---
SECRET_TOKEN=
SECRET_KEY=

# --- Base de datos ---
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_DB=

ENVIRONMENT=

# --- Integraciones existentes (Bsale / SUNAT) ---
ACCESS_TOKEN_BSALE=
API_SUNAT_URL=
API_SUNAT_TOKEN=

# --- Correo (recuperación de contraseña) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Frontend (para construir el link de /reset-password) ---
FRONTEND_URL=http://localhost:4200
